# Click Group website: production settings (server: <deploy dir>/.env, mode 600).
# Copy to .env and fill in PAYLOAD_SECRET:  openssl rand -hex 32
PAYLOAD_SECRET=

# Public address of the website (absolute links, social previews, sitemap).
NEXT_PUBLIC_SERVER_URL=https://clickgroup.co.tz

# Hosts Traefik routes to this container.
SITE_HOST=clickgroup.co.tz
CMS_HOST=cms.clickgroup.co.tz

# false = running privately (no public route); cutover.sh sets true.
ROUTES_ENABLED=false

# Set in docker-compose.yml, listed here for reference:
#   DATABASE_URL=file:/app/data/clickgroup.db   (volume clickgroup-site_data)
#   uploads in /app/media                       (volume clickgroup-site_media)
#   PAYLOAD_SERVER_URL empty: admin works on both hosts with relative URLs
